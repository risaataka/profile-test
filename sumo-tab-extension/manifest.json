{
  "manifest_version": 3,
  "name": "ちゃんこタブ力士",
  "version": "1.0.0",
  "description": "タブを開くほど力士が昇進して大きくなる。24階級、横綱になると画面に塩をまき、下に積もっていく。",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ちゃんこタブ力士",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/ranks.js", "src/rikishi.js", "src/styles.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
